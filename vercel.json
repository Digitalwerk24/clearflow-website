{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.itsclearflow.com"
        }
      ],
      "destination": "https://itsclearflow.com/:path*",
      "permanent": true
    },
    { "source": "/0-2-micron-filtration-explained", "destination": "/2-micron-filtration-explained", "permanent": true },
    { "source": "/bottled-water-in-america", "destination": "/blog/bottled-water-in-america", "permanent": true },
    { "source": "/bottled-water-usa-guide", "destination": "/blog/bottled-water-usa-guide", "permanent": true },
    { "source": "/clear-flow-product-guide", "destination": "/blog/clear-flow-product-guide", "permanent": true },
    { "source": "/microplastics-science-research", "destination": "/blog/microplastics-science-research", "permanent": true },
    { "source": "/on-the-go-microplastic-filters", "destination": "/blog/on-the-go-microplastic-filters", "permanent": true },
    { "source": "/on-the-go-water-filtration", "destination": "/blog/on-the-go-water-filtration", "permanent": true },
    { "source": "/reducing-plastic-exposure", "destination": "/blog/reducing-plastic-exposure", "permanent": true }
  ]
}
